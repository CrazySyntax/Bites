# Copy to `.env` to override the defaults in src/config.ts.
# Any variable left unset falls back to the default shown here.
# Real environment variables (e.g. `PORT=4000 npm start`) take precedence over .env.

# HTTP port the server listens on.
PORT=3000

# Delivery tuning (see DeliveryConfig in src/config.ts).
MAX_ATTEMPTS=5          # attempts before an event is marked `dead`
TIMEOUT_MS=5000         # per-attempt timeout in ms
BACKOFF_BASE_MS=500     # base backoff delay before retry #2
BACKOFF_FACTOR=2        # exponential growth factor between retries
BACKOFF_MAX_MS=30000    # upper bound on a single backoff delay

# Pagination for GET /endpoints/:id/events.
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100

# Capacity limits guarding the in-memory store.
MAX_ENDPOINTS=100
MAX_EVENTS_PER_ENDPOINT=50

# Per-endpoint in-memory working-set size for EventService.
MAX_IN_MEMORY_EVENTS_PER_ENDPOINT=10

# Snapshot file for POST /database/dump and POST /database/load.
DATABASE_FILE=database.json
